# Copy to .env and set the real connection string once the live database is ready.
# This file is never committed. Prisma reads it via prisma.config.ts (dotenv).
#
# The value must be a URL, not a `mysql` shell command. Example: a TiDB Cloud snippet
# like `mysql -u user -h host -P 4000 -D db -p'pass'` becomes:
#
#   DATABASE_URL="mysql://user:pass@host:4000/db?ssl-mode=required"
DATABASE_URL="mysql://USER:PASSWORD@HOST:4000/DBNAME?ssl-mode=required"
